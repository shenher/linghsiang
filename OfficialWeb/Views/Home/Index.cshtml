@{
    ViewData["Title"] = "首頁";
    ViewData["NavVariant"] = "light";
}

<section class="home-hero">
    <div class="home-hero-bg hm-hero-img" style="background-image: url('/Pic/Hero');"></div>
    <div class="home-hero-overlay"></div>

    <div class="home-hero-content">
        <div class="home-hero-badge hm-fade" style="transition-delay: 0ms;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-9 7-14 15-14 0 9-5 15-14 15-1 0-1 0-1-1z" /><path d="M5 19c4-4 7-6 11-7" /></svg>
            全素・接單烘焙・無蛋無奶
        </div>

        <h1 class="home-hero-title hm-mask"><span style="transition-delay: 180ms;">拎香焙室</span></h1>

        <div class="home-hero-en hm-fade" style="transition-delay: 360ms;">Ling Hsiang Bakery</div>

        <p class="home-hero-intro hm-fade" style="transition-delay: 520ms;">
            以米麩、堅果與當令果物，一爐一爐慢慢烘。沒有現貨，每一份都是收到訂單後才為你動手做的。
        </p>

        <div class="home-hero-ctas hm-fade" style="transition-delay: 700ms;">
            <a class="btn-line" href="https://line.me/R/ti/p/@@linghsiang" target="_blank" rel="noopener">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.5 3 2 6.6 2 11c0 4 3.6 7.3 8.5 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5s5.7-3.4 7.7-5.8C21.3 14.4 22 12.8 22 11c0-4.4-4.5-8-10-8zM8 13.4H6c-.2 0-.3-.1-.3-.3v-4c0-.2.1-.3.3-.3s.3.1.3.3v3.7H8c.2 0 .3.1.3.3s-.1.3-.3.3zm1.4-.3c0 .2-.1.3-.3.3s-.3-.1-.3-.3v-4c0-.2.1-.3.3-.3s.3.1.3.3v4zm4.5 0c0 .1-.1.3-.2.3h-.4l-2-2.7v2.4c0 .2-.1.3-.3.3s-.3-.1-.3-.3v-4c0-.1.1-.3.2-.3h.4l2 2.7V9.1c0-.2.1-.3.3-.3s.3.1.3.3v4zm3.1-2.3c.2 0 .3.1.3.3s-.1.3-.3.3h-1.6v1.1H17c.2 0 .3.1.3.3s-.1.3-.3.3h-1.9c-.2 0-.3-.1-.3-.3V9.1c0-.2.1-.3.3-.3H17c.2 0 .3.1.3.3s-.1.3-.3.3h-1.6v1.1H17z"/></svg>
                LINE 下單
            </a>
            <a class="btn-ghost-light" asp-controller="Home" asp-action="Products">
                看看產品
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
        </div>

        <div class="home-hero-hints hm-fade" style="transition-delay: 880ms;">
            <span>提前 5 天預約</span><span class="dot">·</span>
            <span>全素無蛋無奶</span><span class="dot">·</span>
            <span>可備註過敏原</span><span class="dot">·</span>
            <span>僅自取</span>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
