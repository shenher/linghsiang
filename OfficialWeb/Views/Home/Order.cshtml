@{
    ViewData["Title"] = "下單";
}

@* 標題 *@
<section class="order-head">
    <div class="order-head-inner">
        <img src="/Pic/Logo?name=mark" alt="拎香焙室商標" class="order-mark" />
        <div class="sec-label">— HOW TO ORDER · 下單</div>
        <h1 class="order-title">下單，從一句 <span class="hl">LINE</span> 開始</h1>
        <p class="order-sub">沒有現貨、皆為接單製作。跟著下面四步，最慢 24 小時內回覆你。</p>
    </div>
</section>

@* 下單流程（四步驟） *@
<section class="order-flow">
    <div class="wrap-1100">
        <div class="order-flow-grid">
            <div class="order-step">
                <div class="order-step-n">01</div>
                <div>
                    <h3>加入 LINE 好友</h3>
                    <p>掃描下方 QRCode 或點按鈕，加入官方 LINE。</p>
                </div>
            </div>
            <div class="order-step">
                <div class="order-step-n">02</div>
                <div>
                    <h3>私訊告知需求</h3>
                    <p>告訴我品項、份量與想取貨的日期，請提前 5 天預約。</p>
                </div>
            </div>
            <div class="order-step">
                <div class="order-step-n">03</div>
                <div>
                    <h3>確認與付訂</h3>
                    <p>一起確認口味與取貨日，匯款訂金後正式排入烘焙排程。</p>
                </div>
            </div>
            <div class="order-step">
                <div class="order-step-n">04</div>
                <div>
                    <h3>到店取貨</h3>
                    <p>完成後 LINE 通知，到店自取，當日新鮮最好吃。</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* LINE 主要下單卡 *@
<section class="order-main">
    <div class="order-main-inner">
        <div class="order-line-card">
            <span class="order-line-badge">PRIMARY · 下單請走這裡</span>

            <div class="order-qr-wrap">
                <div class="order-qr">
                    <img src="/Pic/LineQr" alt="LINE 加好友 QRCode"
                         onerror="this.closest('.order-qr').classList.add('is-placeholder');" />
                    <div class="order-qr-ph">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="#06C755"><path d="M12 3C6.5 3 2 6.6 2 11c0 4 3.6 7.3 8.5 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5s5.7-3.4 7.7-5.8C21.3 14.4 22 12.8 22 11c0-4.4-4.5-8-10-8zM8 13.4H6c-.2 0-.3-.1-.3-.3v-4c0-.2.1-.3.3-.3s.3.1.3.3v3.7H8c.2 0 .3.1.3.3s-.1.3-.3.3zm1.4-.3c0 .2-.1.3-.3.3s-.3-.1-.3-.3v-4c0-.2.1-.3.3-.3s.3.1.3.3v4zm4.5 0c0 .1-.1.3-.2.3h-.4l-2-2.7v2.4c0 .2-.1.3-.3.3s-.3-.1-.3-.3v-4c0-.1.1-.3.2-.3h.4l2 2.7V9.1c0-.2.1-.3.3-.3s.3.1.3.3v4zm3.1-2.3c.2 0 .3.1.3.3s-.1.3-.3.3h-1.6v1.1H17c.2 0 .3.1.3.3s-.1.3-.3.3h-1.9c-.2 0-.3-.1-.3-.3V9.1c0-.2.1-.3.3-.3H17c.2 0 .3.1.3.3s-.1.3-.3.3h-1.6v1.1H17z"/></svg>
                        <div>LINE QRCODE</div>
                        <div class="hint">請將 QRCode 圖檔放入 Pic/qrcode/line.png</div>
                    </div>
                </div>
            </div>

            <div class="order-line-text">
                <div class="order-line-kbl">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="#06C755"><path d="M12 3C6.5 3 2 6.6 2 11c0 4 3.6 7.3 8.5 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5s5.7-3.4 7.7-5.8C21.3 14.4 22 12.8 22 11c0-4.4-4.5-8-10-8zM8 13.4H6c-.2 0-.3-.1-.3-.3v-4c0-.2.1-.3.3-.3s.3.1.3.3v3.7H8c.2 0 .3.1.3.3s-.1.3-.3.3zm1.4-.3c0 .2-.1.3-.3.3s-.3-.1-.3-.3v-4c0-.2.1-.3.3-.3s.3.1.3.3v4zm4.5 0c0 .1-.1.3-.2.3h-.4l-2-2.7v2.4c0 .2-.1.3-.3.3s-.3-.1-.3-.3v-4c0-.1.1-.3.2-.3h.4l2 2.7V9.1c0-.2.1-.3.3-.3s.3.1.3.3v4zm3.1-2.3c.2 0 .3.1.3.3s-.1.3-.3.3h-1.6v1.1H17c.2 0 .3.1.3.3s-.1.3-.3.3h-1.9c-.2 0-.3-.1-.3-.3V9.1c0-.2.1-.3.3-.3H17c.2 0 .3.1.3.3s-.1.3-.3.3h-1.6v1.1H17z"/></svg>
                    LINE
                </div>
                <div class="order-line-title">掃 QRCode 加好友 · 直接下單</div>
                <div class="order-line-desc">
                    LINE ID：<span class="lineid">@@linghsiang</span><br />
                    告訴我品項、份量與想取貨的日期即可。
                </div>
                <a class="btn-line order-line-btn" href="https://line.me/R/ti/p/@@linghsiang" target="_blank" rel="noopener">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.5 3 2 6.6 2 11c0 4 3.6 7.3 8.5 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5s5.7-3.4 7.7-5.8C21.3 14.4 22 12.8 22 11c0-4.4-4.5-8-10-8zM8 13.4H6c-.2 0-.3-.1-.3-.3v-4c0-.2.1-.3.3-.3s.3.1.3.3v3.7H8c.2 0 .3.1.3.3s-.1.3-.3.3zm1.4-.3c0 .2-.1.3-.3.3s-.3-.1-.3-.3v-4c0-.2.1-.3.3-.3s.3.1.3.3v4zm4.5 0c0 .1-.1.3-.2.3h-.4l-2-2.7v2.4c0 .2-.1.3-.3.3s-.3-.1-.3-.3v-4c0-.1.1-.3.2-.3h.4l2 2.7V9.1c0-.2.1-.3.3-.3s.3.1.3.3v4zm3.1-2.3c.2 0 .3.1.3.3s-.1.3-.3.3h-1.6v1.1H17c.2 0 .3.1.3.3s-.1.3-.3.3h-1.9c-.2 0-.3-.1-.3-.3V9.1c0-.2.1-.3.3-.3H17c.2 0 .3.1.3.3s-.1.3-.3.3h-1.6v1.1H17z"/></svg>
                    點此加入 LINE 好友
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
            </div>
        </div>

        @* 說明：以 LINE 為主 *@
        <div class="order-note">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-9 7-14 15-14 0 9-5 15-14 15-1 0-1 0-1-1z" /><path d="M5 19c4-4 7-6 11-7" /></svg>
            <div class="order-note-text">
                <strong>現在下單以 LINE 為主，回覆最快。</strong><br />
                <span>Facebook 與 Instagram 主要發布最新出爐與店休消息；如需訂購，仍請加 LINE 私訊，確認更完整也更快。</span>
            </div>
        </div>

        @* 其他管道 *@
        <div class="order-others">
            <a class="order-other" href="https://www.instagram.com/linghsiang.bakery" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.8" fill="var(--accent)" /></svg>
                <div class="order-other-body">
                    <div class="kbl">INSTAGRAM</div>
                    <div class="main">@@linghsiang.bakery</div>
                </div>
                <svg class="arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a class="order-other" href="https://www.facebook.com/linghsiangbakery/" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)"><path d="M14 9V7.5c0-.7.3-1 1-1h2V3h-3c-2.3 0-4 1.5-4 4v2H7v3.5h3V21h4v-8.5h2.7l.3-3.5H14z" /></svg>
                <div class="order-other-body">
                    <div class="kbl">FACEBOOK</div>
                    <div class="main">linghsiangbakery</div>
                </div>
                <svg class="arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
        </div>
    </div>
</section>
