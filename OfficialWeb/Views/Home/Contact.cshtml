@{
    ViewData["Title"] = "聯絡我們";
}

<div class="py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <h2 class="bakery-font text-center mb-4">聯絡我們</h2>

            <div class="text-center mt-4 fs-6 text-muted">
                <p><strong>門市地址：</strong>桃園市平鎮區南昌街64巷9號1樓</p>
                <p><strong>營業時間：</strong>週一至週四 13:00 – 18:00，週五 13:00 - 17:00</p>
                <p><strong>聯絡電話：</strong>03-4392263</p>
            </div>

            <div class="text-center mt-5">
                <p class="fw-semibold mb-1">主要聯絡方式</p>
                <p class="text-muted fs-6 mb-4">歡迎透過 Instagram 或 Facebook 私訊我們，回覆速度最快！</p>
                <div class="row justify-content-center g-4">
                    <div class="col-auto text-center">
                        <p class="fw-semibold mb-2">Instagram</p>
                        <div class="border rounded p-2 d-inline-block" style="width:160px; height:160px; background:#f8f5f0; line-height:136px; color:#bbb; font-size:0.8rem;">
                            <img src="~/images/ig-qrcode.png" alt="Instagram QR Code" style="width:160px; height:160px;" />
                        </div>
                    </div>
                    <div class="col-auto text-center">
                        <p class="fw-semibold mb-2">Facebook</p>
                        <div class="border rounded p-2 d-inline-block" style="width:160px; height:160px; background:#f8f5f0; line-height:136px; color:#bbb; font-size:0.8rem;">
                            <img src="~/images/fb-qrcode.png" alt="Facebook QR Code" style="width:160px; height:160px;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
