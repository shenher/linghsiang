@model OfficialWeb.Models.ContactViewModel
@{
    ViewData["Title"] = "聯絡我們";
}

<div class="py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <h2 class="bakery-font text-center mb-2">聯絡我們</h2>
            <p class="text-center mb-4">有任何問題或預訂需求，請填寫下方表單，我們將盡速與您聯繫。</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
                </div>
            }

            <div class="card p-4 contact-form">
                <form asp-controller="Home" asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">姓名 <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="請輸入您的姓名" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-semibold">聯絡電話</label>
                        <input asp-for="Phone" class="form-control" placeholder="例：0912-345-678" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">電子郵件 <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" placeholder="example@mail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label fw-semibold">主旨</label>
                        <select asp-for="Subject" class="form-select">
                            <option value="">-- 請選擇 --</option>
                            <option value="訂購詢問">訂購詢問</option>
                            <option value="客製化蛋糕">客製化蛋糕</option>
                            <option value="門市相關">門市相關</option>
                            <option value="其他">其他</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Message" class="form-label fw-semibold">留言內容 <span class="text-danger">*</span></label>
                        <textarea asp-for="Message" class="form-control" rows="5" placeholder="請描述您的需求或問題…"></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-bakery">送出留言</button>
                    </div>
                </form>
            </div>

            <div class="text-center mt-4 fs-6 text-muted">
                <p><strong>門市地址：</strong>桃園市平鎮區南昌街64巷9號1樓</p>
                <p><strong>營業時間：</strong>週一至週四 13:00 – 18:00，週五 13:00 - 17:00</p>
                <p><strong>聯絡電話：</strong>03-4392263</p>
            </div>

            <div class="text-center mt-5">
                <p class="fw-semibold mb-1">主要聯絡方式</p>
                <p class="text-muted fs-6 mb-4">歡迎透過 Instagram 或 Facebook 私訊我們，回覆速度最快！</p>
                <div class="row justify-content-center g-4">
                    <div class="col-auto text-center">
                        <p class="fw-semibold mb-2">Instagram</p>
                        <div class="border rounded p-2 d-inline-block" style="width:160px; height:160px; background:#f8f5f0; line-height:136px; color:#bbb; font-size:0.8rem;">
                            <img src="~/images/ig-qrcode.png" alt="Instagram QR Code" style="width:160px; height:160px;" />
                        </div>
                    </div>
                    <div class="col-auto text-center">
                        <p class="fw-semibold mb-2">Facebook</p>
                        <div class="border rounded p-2 d-inline-block" style="width:160px; height:160px; background:#f8f5f0; line-height:136px; color:#bbb; font-size:0.8rem;">
                            <img src="~/images/fb-qrcode.png" alt="Facebook QR Code" style="width:160px; height:160px;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
