@using Microsoft.Extensions.Options
@using OfficialWeb.Models.Settings
@inject IOptions<SiteSettings> SiteOptions
@{
    // 全站字體：appsettings.json → SiteSettings:FontFamily 驅動；空值 fallback 設計稿預設
    var fontFamily = string.IsNullOrWhiteSpace(SiteOptions.Value.FontFamily)
        ? "Noto Sans TC"
        : SiteOptions.Value.FontFamily!.Trim();
    var fontQuery = Uri.EscapeDataString(fontFamily).Replace("%20", "+");

    // 導覽列型態：首頁 light（透明疊 Hero 白字）／內頁 solid（sticky 實色）
    var navVariant = (ViewData["NavVariant"] as string) == "light" ? "light" : "solid";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string NavClass(string target) => action == target ? "site-nav-link active" : "site-nav-link";
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="拎香焙室 LING HSIANG BAKERY — 全素・接單烘焙・小爐慢做" />
    <title>@(ViewData["Title"] is string t && !string.IsNullOrEmpty(t) ? $"拎香焙室 · {t}" : "拎香焙室 Ling Hsiang Bakery")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @* 字體名若為系統字體，CDN 查無僅回 404 不影響顯示，直接落到 fallback *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=@(fontQuery):wght@400;500;600;700&display=swap" />
    <style>:root { --site-font: '@fontFamily'; }</style>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(navVariant == "light" ? "has-light-nav" : "")">
    <header class="site-nav @(navVariant == "light" ? "site-nav--light" : "site-nav--solid")">
        <a class="site-nav-brand" asp-controller="Home" asp-action="Index" aria-label="拎香焙室 Ling Hsiang Bakery 回首頁">
            <img src="@(navVariant == "light" ? "/Pic/Logo?name=h-white" : "/Pic/Logo?name=h-gold")"
                 alt="拎香焙室 Ling Hsiang Bakery" class="site-nav-logo" />
        </a>
        <nav class="site-nav-links" aria-label="主要導覽">
            <a class="@NavClass("About")" asp-controller="Home" asp-action="About">關於</a>
            <a class="@(action is "Products" or "ProductDetail" ? "site-nav-link active" : "site-nav-link")"
               asp-controller="Home" asp-action="Products">產品</a>
            <a class="@NavClass("Order")" asp-controller="Home" asp-action="Order">下單</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer-brand">
            <img src="/Pic/Logo?name=mark" alt="" class="site-footer-mark" />
            <div>
                <div class="site-footer-name">拎香焙室</div>
                <div class="site-footer-est">EST · 2024 · 全素・接單烘焙</div>
            </div>
        </div>
        <nav class="site-footer-links" aria-label="頁尾導覽">
            <a asp-controller="Home" asp-action="Index">首頁</a>
            <a asp-controller="Home" asp-action="About">關於</a>
            <a asp-controller="Home" asp-action="Products">產品</a>
            <a asp-controller="Home" asp-action="Order">下單</a>
        </nav>
        <div class="site-footer-social">
            <a href="https://www.instagram.com/linghsiang.bakery" target="_blank" rel="noopener" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" /></svg>
            </a>
            <a href="https://www.facebook.com/linghsiangbakery/" target="_blank" rel="noopener" aria-label="Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M14 9V7.5c0-.7.3-1 1-1h2V3h-3c-2.3 0-4 1.5-4 4v2H7v3.5h3V21h4v-8.5h2.7l.3-3.5H14z" /></svg>
            </a>
            <a href="https://line.me/R/ti/p/@@linghsiang" target="_blank" rel="noopener" aria-label="LINE">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.5 3 2 6.6 2 11c0 4 3.6 7.3 8.5 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5s5.7-3.4 7.7-5.8C21.3 14.4 22 12.8 22 11c0-4.4-4.5-8-10-8zM8 13.4H6c-.2 0-.3-.1-.3-.3v-4c0-.2.1-.3.3-.3s.3.1.3.3v3.7H8c.2 0 .3.1.3.3s-.1.3-.3.3zm1.4-.3c0 .2-.1.3-.3.3s-.3-.1-.3-.3v-4c0-.2.1-.3.3-.3s.3.1.3.3v4zm4.5 0c0 .1-.1.3-.2.3h-.4l-2-2.7v2.4c0 .2-.1.3-.3.3s-.3-.1-.3-.3v-4c0-.1.1-.3.2-.3h.4l2 2.7V9.1c0-.2.1-.3.3-.3s.3.1.3.3v4zm3.1-2.3c.2 0 .3.1.3.3s-.1.3-.3.3h-1.6v1.1H17c.2 0 .3.1.3.3s-.1.3-.3.3h-1.9c-.2 0-.3-.1-.3-.3V9.1c0-.2.1-.3.3-.3H17c.2 0 .3.1.3.3s-.1.3-.3.3h-1.6v1.1H17z"/></svg>
            </a>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
