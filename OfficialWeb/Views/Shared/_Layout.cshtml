@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="拎香培室 LING HSIANG BAKERY — 手工烘焙，天然美味" />
    <title>@ViewData["Title"] - 拎香培室 LING HSIANG BAKERY</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-bakery shadow-sm" aria-label="主要導覽">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 bakery-font" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo.svg" alt="拎香培室 Logo" height="36" class="me-2" />
                    拎香培室
                </a>
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#bakeryNavbar"
                        aria-controls="bakeryNavbar" aria-expanded="false" aria-label="切換導覽列">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="bakeryNavbar">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index"
                               aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "page" : null)">首頁</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")"
                               asp-controller="Home" asp-action="About"
                               aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "page" : null)">關於我們</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "active" : "")"
                               asp-controller="Home" asp-action="Products"
                               aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "page" : null)">產品介紹</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")"
                               asp-controller="Home" asp-action="Contact"
                               aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "page" : null)">聯絡我們</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="bg-hero py-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>
    <footer class="bg-bakery text-center p-4 bakery-font fs-6 text-bakery-footer">
        &copy; @DateTime.Now.Year 拎香培室 LING HSIANG BAKERY｜版權所有
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
            crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>